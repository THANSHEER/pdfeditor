{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdfeditor",
  "compatibility_date": "2026-04-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/pdf-toolkit/browser",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
    "routes": [
    {
      "pattern": "pdfeditor.geekstash.dev/*",
      "zone_name": "geekstash.dev"
    }
  ]
}
